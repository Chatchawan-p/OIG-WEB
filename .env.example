# Application
APP_ENV=development
APP_PORT=18080

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=oig

# JWT (use at least 32 random characters outside development)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=15m

# Discord OAuth2
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:18080/api/v1/auth/discord/callback

# Comma-separated exact origins; wildcard origins are rejected.
# These origins also define the allowed frontend destinations for OAuth2 return_to redirects.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:18080,http://localhost:5173
SWAGGER_ENABLED=true

# Evidence uploads (1 KiB to 20 MiB; default shown is 5 MiB)
EVIDENCE_STORAGE_PATH=data/evidence
EVIDENCE_MAX_BYTES=5242880
